{
  "about": "Decode then validate each document (with limits, when given). issues lists the expected issue codes in order ([] for valid). A raw case is text to decode: decodeError says whether decoding must fail. encoded, when present, is the canonical encoding of the decoded model.",
  "cases": [
    {"name": "fixture app is valid", "document": "@app", "issues": []},
    {"name": "smallest model", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S", "nodes": [], "edges": []}, "issues": [],
      "encoded": "{\"edges\":[],\"format\":\"craggy.model\",\"nodes\":[],\"subject\":\"S\",\"title\":\"T\",\"version\":2}"},
    {"name": "missing lists decode as empty", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S"}, "issues": [],
      "encoded": "{\"edges\":[],\"format\":\"craggy.model\",\"nodes\":[],\"subject\":\"S\",\"title\":\"T\",\"version\":2}"},
    {"name": "numbers and strings encode canonically", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A & B", "properties": {"n": 1.0, "f": 2.5, "neg": -3, "big": 1e3, "flag": true, "s": "x<y"}}], "edges": []}, "issues": [],
      "encoded": "{\"edges\":[],\"format\":\"craggy.model\",\"nodes\":[{\"id\":\"a\",\"label\":\"A \\u0026 B\",\"properties\":{\"big\":1000,\"f\":2.5,\"flag\":true,\"n\":1,\"neg\":-3,\"s\":\"x\\u003cy\"}}],\"subject\":\"S\",\"title\":\"T\",\"version\":2}"},
    {"name": "evidence ids are filled", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A", "evidence": [
        {"caption": "one", "ref": {"scheme": "artifact", "id": "x"}},
        {"id": "ev1", "caption": "two", "ref": {"scheme": "url", "id": "https://example.com"}},
        {"caption": "three", "ref": {"scheme": "file", "id": "notes.txt"}}]}], "edges": []}, "issues": [],
      "encoded": "{\"edges\":[],\"format\":\"craggy.model\",\"nodes\":[{\"evidence\":[{\"caption\":\"one\",\"id\":\"ev2\",\"ref\":{\"id\":\"x\",\"scheme\":\"artifact\"}},{\"caption\":\"two\",\"id\":\"ev1\",\"ref\":{\"id\":\"https://example.com\",\"scheme\":\"url\"}},{\"caption\":\"three\",\"id\":\"ev3\",\"ref\":{\"id\":\"notes.txt\",\"scheme\":\"file\"}}],\"id\":\"a\",\"label\":\"A\"}],\"subject\":\"S\",\"title\":\"T\",\"version\":2}"},
    {"name": "wrong format", "document": {"format": "other", "version": 2, "title": "T", "subject": "S", "nodes": [], "edges": []}, "issues": ["format"]},
    {"name": "blank title and subject", "document": {"format": "craggy.model", "version": 2, "title": " ", "subject": "", "nodes": [], "edges": []}, "issues": ["title", "subject"]},
    {"name": "bad and duplicate ids", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "-x", "label": "A"}, {"id": "b", "label": "B"}, {"id": "b", "label": "B2"}], "edges": []}, "issues": ["id.invalid", "id.duplicate"]},
    {"name": "empty labels", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": ""}, {"id": "b", "label": "B"}], "edges": [{"id": "e", "from": "a", "to": "b", "label": " "}]}, "issues": ["label.empty", "label.empty"]},
    {"name": "parent problems", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A", "parent": "a"}, {"id": "b", "label": "B", "parent": "nope"}], "edges": []}, "issues": ["parent.self", "parent.missing"]},
    {"name": "containment cycle", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A", "parent": "c"}, {"id": "b", "label": "B", "parent": "a"}, {"id": "c", "label": "C", "parent": "b"}, {"id": "d", "label": "D", "parent": "a"}], "edges": []},
      "issues": ["parent.cycle", "parent.cycle", "parent.cycle"]},
    {"name": "edge endpoints", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A"}], "edges": [{"id": "e", "from": "a", "to": "z", "label": "x"}, {"id": "e", "from": "a", "to": "a", "label": "self"}]},
      "issues": ["edge.endpoint", "id.duplicate"]},
    {"name": "element fields", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S", "tags": ["a", "a"],
      "nodes": [{"id": "a", "label": "A", "kind": "bad kind", "tags": [""], "properties": {"1bad": 1, "ok": "v"},
        "evidence": [{"id": "x", "caption": "", "ref": {"scheme": "Artifact", "id": ""}}, {"id": "x", "caption": "c", "ref": {"scheme": "artifact", "id": "y"}}],
        "link": {"model": ""}}], "edges": []},
      "issues": ["tag.invalid", "kind.invalid", "tag.invalid", "property.key", "evidence.caption", "evidence.ref", "evidence.id", "link.model"]},
    {"name": "views", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S", "nodes": [], "edges": [],
      "views": [{"id": "v", "title": "V", "renderer": "blocks"}, {"id": "v", "title": "V2", "renderer": "Blocks!"}]}, "issues": ["view.id", "view.renderer"]},
    {"name": "depth limit", "limits": {"maxDepth": 2}, "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A"}, {"id": "b", "label": "B", "parent": "a"}, {"id": "c", "label": "C", "parent": "b"}], "edges": []}, "issues": ["bounds.depth"]},
    {"name": "node and ref limits", "limits": {"maxNodes": 1, "maxRefs": 1}, "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A", "evidence": [{"caption": "1", "ref": {"scheme": "artifact", "id": "x"}}]},
                {"id": "b", "label": "B", "evidence": [{"caption": "2", "ref": {"scheme": "artifact", "id": "y"}}]}], "edges": []}, "issues": ["bounds.nodes", "bounds.refs"]},
    {"name": "property value types", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S",
      "nodes": [{"id": "a", "label": "A", "properties": {"list": [1], "obj": {"x": 1}, "nil": null}}], "edges": []}, "issues": ["property.value", "property.value", "property.value"]},
    {"name": "unknown field", "raw": "{\"format\":\"craggy.model\",\"version\":2,\"title\":\"T\",\"subject\":\"S\",\"nodes\":[],\"edges\":[],\"colour\":\"red\"}", "decodeError": true},
    {"name": "unsupported version", "raw": "{\"version\":3,\"title\":\"T\",\"subject\":\"S\"}", "decodeError": true},
    {"name": "trailing document", "raw": "{\"format\":\"craggy.model\",\"version\":2,\"title\":\"T\",\"subject\":\"S\"} {}", "decodeError": true},
    {"name": "not json", "raw": "nodes: []", "decodeError": true},
    {"name": "field names are case-exact", "raw": "{\"format\":\"craggy.model\",\"version\":2,\"TITLE\":\"T\",\"subject\":\"S\",\"nodes\":[],\"edges\":[]}", "decodeError": true},
    {"name": "nested field names are case-exact", "raw": "{\"format\":\"craggy.model\",\"version\":2,\"title\":\"T\",\"subject\":\"S\",\"nodes\":[{\"id\":\"a\",\"Label\":\"A\"}],\"edges\":[]}", "decodeError": true},
    {"name": "free-form maps keep any key", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S", "nodes": [{"id": "a", "label": "A", "properties": {"Label": "x", "TITLE": 1}}], "edges": [], "views": [{"id": "v", "renderer": "graph", "positions": {"a": [1, 2]}, "options": {"Zoom": 2}}]}, "issues": []},
    {"name": "view sizes", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S", "nodes": [{"id": "a", "label": "A"}, {"id": "b", "label": "B", "parent": "a"}], "edges": [],
      "views": [{"id": "v", "renderer": "blocks", "sizes": {"b": {"w": 4}, "a": {"w": 10, "h": 3}}}]}, "issues": [],
      "encoded": "{\"edges\":[],\"format\":\"craggy.model\",\"nodes\":[{\"id\":\"a\",\"label\":\"A\"},{\"id\":\"b\",\"label\":\"B\",\"parent\":\"a\"}],\"subject\":\"S\",\"title\":\"T\",\"version\":2,\"views\":[{\"id\":\"v\",\"renderer\":\"blocks\",\"sizes\":{\"a\":{\"h\":3,\"w\":10},\"b\":{\"w\":4}}}]}"},
    {"name": "view size bounds", "document": {"format": "craggy.model", "version": 2, "title": "T", "subject": "S", "nodes": [], "edges": [],
      "views": [{"id": "v", "renderer": "blocks", "sizes": {"a": {"w": 11}, "b": {}, "c": {"w": 3, "h": 21}, "d": {"w": -1}, "-x": {"w": 1}, "ok": {"h": 20}}}]},
      "issues": ["view.size", "view.size", "view.size", "view.size", "view.size"]},
    {"name": "size field names are case-exact", "raw": "{\"format\":\"craggy.model\",\"version\":2,\"title\":\"T\",\"subject\":\"S\",\"views\":[{\"id\":\"v\",\"renderer\":\"blocks\",\"sizes\":{\"a\":{\"W\":2}}}]}", "decodeError": true},
    {"name": "size values are integers", "raw": "{\"format\":\"craggy.model\",\"version\":2,\"title\":\"T\",\"subject\":\"S\",\"views\":[{\"id\":\"v\",\"renderer\":\"blocks\",\"sizes\":{\"a\":{\"w\":2.5}}}]}", "decodeError": true},
    {"name": "unknown v1 field", "raw": "{\"version\":1,\"title\":\"T\",\"subject\":\"S\",\"nodes\":[{\"id\":\"a\",\"label\":\"A\",\"kind\":\"x\"}],\"edges\":[]}", "decodeError": true}
  ]
}
