{
  "about": "apply(model, ops) must give result, or fail with error {index, code} (index -1: the result failed validation). For every success, applying the returned inverse to the result must give back model exactly, and inverse must equal the expected inverse when one is listed.",
  "cases": [
    {"name": "add a child area at a position", "model": "@app",
      "ops": [{"op": "node.add", "node": {"id": "store", "label": "Storage", "parent": "app"}, "index": 3}]},
    {"name": "add and connect", "model": "@app",
      "ops": [{"op": "node.add", "node": {"id": "db", "label": "Database"}},
              {"op": "edge.add", "edge": {"id": "e5", "from": "server", "to": "db", "label": "stores in"}}]},
    {"name": "remove a leaf", "model": "@app", "ops": [{"op": "node.remove", "id": "server", "cascade": true}]},
    {"name": "refuse removing a non-empty area", "model": "@app", "ops": [{"op": "node.remove", "id": "net"}], "error": {"index": 0, "code": "op.not-empty"}},
    {"name": "cascade removes descendants and edges", "model": "@app", "ops": [{"op": "node.remove", "id": "net", "cascade": true}]},
    {"name": "move keeps position", "model": "@app", "ops": [{"op": "node.move", "id": "pinner", "parent": "app"}]},
    {"name": "move to top level at a position", "model": "@app", "ops": [{"op": "node.move", "id": "ui", "index": 0}]},
    {"name": "move into own descendant is refused by validation", "model": "@app", "ops": [{"op": "node.move", "id": "app", "parent": "pinner"}],
      "error": {"index": -1, "code": "parent.cycle"}},
    {"name": "set node fields", "model": "@app",
      "ops": [{"op": "node.set", "id": "net", "fields": {"label": "Networking", "notes": null, "tags": ["a", "b"], "link": {"model": "m-net", "node": "root"}}}]},
    {"name": "clear a link and a kind", "model": "@app", "ops": [{"op": "node.set", "id": "native", "fields": {"link": null, "kind": ""}}]},
    {"name": "refuse an unknown field", "model": "@app", "ops": [{"op": "node.set", "id": "net", "fields": {"parent": "x"}}], "error": {"index": 0, "code": "op.field"}},
    {"name": "set edge ends", "model": "@app", "ops": [{"op": "edge.set", "id": "e3", "fields": {"from": "net", "undirected": true}}]},
    {"name": "edge to a missing node fails validation", "model": "@app", "ops": [{"op": "edge.set", "id": "e3", "fields": {"to": "nowhere"}}],
      "error": {"index": -1, "code": "edge.endpoint"}},
    {"name": "remove an edge", "model": "@app", "ops": [{"op": "edge.remove", "id": "e2"}]},
    {"name": "properties", "model": "@app",
      "ops": [{"op": "prop.set", "target": "node", "id": "net", "key": "language", "value": "java"},
              {"op": "prop.set", "target": "edge", "id": "e1", "key": "weight", "value": 3},
              {"op": "prop.unset", "target": "node", "id": "ui", "key": "language"},
              {"op": "prop.unset", "target": "node", "id": "ui", "key": "missing"}]},
    {"name": "refuse a non-scalar property", "model": "@app", "ops": [{"op": "prop.set", "target": "node", "id": "net", "key": "x", "value": [1]}],
      "error": {"index": 0, "code": "op.field"}},
    {"name": "evidence add, dedupe and remove", "model": "@app",
      "ops": [{"op": "evidence.add", "target": "node", "id": "net", "evidence": {"caption": "Decompiled", "ref": {"scheme": "artifact", "id": "a9"}}},
              {"op": "evidence.add", "target": "node", "id": "net", "evidence": {"caption": "Again", "ref": {"scheme": "artifact", "id": "a1", "selector": "/res/xml/nsc.xml"}}},
              {"op": "evidence.remove", "target": "edge", "id": "e2", "evidenceId": "ev1"}]},
    {"name": "model fields", "model": "@app", "ops": [{"op": "model.set", "fields": {"title": "Pay", "profile": "", "tags": ["x"]}}]},
    {"name": "views put and remove", "model": "@app",
      "ops": [{"op": "view.put", "view": {"id": "overview", "title": "Overview", "renderer": "graph", "positions": {"app": [10, 20]}}},
              {"op": "view.put", "view": {"id": "list", "title": "List", "renderer": "outline"}, "index": 0},
              {"op": "view.remove", "id": "overview"}]},
    {"name": "view.put with sizes", "model": "@app",
      "ops": [{"op": "view.put", "view": {"id": "overview", "title": "Overview", "renderer": "blocks", "collapsed": ["net"], "sizes": {"ui": {"w": 4}, "net": {"w": 6, "h": 3}}}},
              {"op": "view.put", "view": {"id": "overview", "title": "Overview", "renderer": "blocks", "collapsed": ["net"], "sizes": {"ui": {"w": 5, "h": 2}}}}]},
    {"name": "view.put refuses an out-of-range size", "model": "@app",
      "ops": [{"op": "view.put", "view": {"id": "overview", "renderer": "blocks", "sizes": {"ui": {"w": 12}}}}], "error": {"index": -1, "code": "view.size"}},
    {"name": "missing target", "model": "@app", "ops": [{"op": "node.add", "node": {"id": "x", "label": "X"}}, {"op": "edge.remove", "id": "nope"}],
      "error": {"index": 1, "code": "op.missing"}},
    {"name": "duplicate id", "model": "@app", "ops": [{"op": "node.add", "node": {"id": "ui", "label": "Again"}}], "error": {"index": 0, "code": "op.exists"}},
    {"name": "index out of range", "model": "@app", "ops": [{"op": "node.add", "node": {"id": "x", "label": "X"}, "index": 99}], "error": {"index": 0, "code": "op.index"}},
    {"name": "unknown op", "model": "@app", "ops": [{"op": "node.rename", "id": "ui"}], "error": {"index": 0, "code": "op.unknown"}}
  ]
}
